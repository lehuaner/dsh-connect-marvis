{
  "name": "dsh-connect-marvis",
  "version": "0.1.3",
  "description": "Marvis（腾讯马维斯）provider for DSH —— 复用本机已登录的 Marvis 客户端登录态，直接接入 DeepSeek V4.1 Flash / V4 Pro、Claude Sonnet 4.6、GPT-5.4、混元视觉等模型，无需填 API Key。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "verify": "node probe/verify.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "marvis",
    "llm-provider",
    "tencent",
    "hunyuan",
    "deepseek"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lehuaner/dsh-connect-marvis.git"
  },
  "homepage": "https://github.com/lehuaner/dsh-connect-marvis#readme",
  "bugs": {
    "url": "https://github.com/lehuaner/dsh-connect-marvis/issues"
  },
  "license": "MIT"
}